 			// SendBuffers and left on the new socket: it stands, and a second
 			// one on its heels would only be dropped as a replay.
 			peer.handshake.mutex.Lock()
-			if peer.handshake.lastSentHandshake.Before(started) {
+			voided := peer.handshake.lastSentHandshake.Before(started)
+			if voided {
 				peer.handshake.lastSentHandshake = time.Now().Add(-(device.rekeyMinTimeout() + time.Second))
 			}
 			peer.handshake.mutex.Unlock()
+			if voided {
+				// The voided initiation armed the retransmit timer, and
+				// SendHandshakeInitiation(false) leaves a pending cycle to
+				// that timer (the demand guard in send.go), which would
+				// swallow this re-initiation (nudge: the cycle is pending
+				// while the wake-up lands). The cycle belonged to the closed
+				// socket: end it, the initiation below starts a new one and
+				// re-arms the timer. Not done for an initiation stamped after
+				// the rebind began: it stands, with its timer.
+				peer.timers.retransmitHandshake.Del()
+			}
 			peer.SendHandshakeInitiation(false)
 		}
 	}()
diff --git a/submodules/wireguard-go/device/lx_nudge_pending_test.go b/submodules/wireguard-go/device/lx_nudge_pending_test.go
new file mode 100644
index 0000000..a5d63a0
--- /dev/null
+++ b/submodules/wireguard-go/device/lx_nudge_pending_test.go
@@ -0,0 +1,51 @@
+/* SPDX-License-Identifier: MIT
+ *
+ * lx: the pending-cycle guard in SendHandshakeInitiation (demand leaves a
+ * pending handshake cycle to the retry timer) must not swallow the
+ * re-initiation that follows a self-heal rebind.
+ */
+
+package device
+
+import (
+	"testing"
+	"time"
+)
+
+// TestNudgeReinitiatesDuringPendingCycle: the wake nudge lands while a
+// handshake cycle is pending (the retry timer was armed by the initiation that
+// just left on the soon-to-be-closed socket). After the rebind a new
+// initiation goes out at once, with no further traffic (the tunnel may then
+// complete and drop the timer, so only the initiation is asserted).
+func TestNudgeReinitiatesDuringPendingCycle(t *testing.T) {
+	pair := newGiveUpPair(t, true)
+
+	pair.tunA.toDevice <- buildIPv4Packet(testIPA, testIPB, 8)
+	peer := peerOf(t, pair.devA, pair.pkB)
+	awaitInitiationSent(t, peer)
+	if !peer.timers.retransmitHandshake.IsPending() {
+		t.Fatal("retry timer not armed after the first initiation")
+	}
+	peer.handshake.mutex.RLock()
+	before := peer.handshake.lastSentHandshake
+	peer.handshake.mutex.RUnlock()
+
+	if !pair.devA.RebindIfSessionStale() {
+		t.Fatal("nudge on a cold session must rebind")
+	}
+	waitOpens(t, pair.bindA, 2)
+
+	deadline := time.Now().Add(2 * time.Second)
+	for {
+		peer.handshake.mutex.RLock()
+		after := peer.handshake.lastSentHandshake
+		peer.handshake.mutex.RUnlock()
+		if after.After(before) {
+			return
+		}
+		if time.Now().After(deadline) {
+			t.Fatal("no re-initiation after the nudge rebind: swallowed by the pending-cycle guard")
+		}
+		time.Sleep(5 * time.Millisecond)
+	}
+}
