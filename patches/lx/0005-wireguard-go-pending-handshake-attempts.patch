diff --git a/submodules/wireguard-go/device/lx_demand_attempts_test.go b/submodules/wireguard-go/device/lx_demand_attempts_test.go
new file mode 100644
index 0000000..4ddf5dd
--- /dev/null
+++ b/submodules/wireguard-go/device/lx_demand_attempts_test.go
@@ -0,0 +1,111 @@
+/* SPDX-License-Identifier: MIT
+ *
+ * lx: SPEC 041 — traffic demand must not reset the handshake attempt counter
+ * while a handshake is pending. Field failure (Windows, WARP endpoint behind a
+ * dead 5-tuple after a core restart): every packet staged during the pending
+ * handshake called SendHandshakeInitiation(false), which zeroed the counter
+ * before the rate limit returned without sending. Under steady traffic the
+ * retry log read "try 2" forever, the early self-heal rebind (>=3 unanswered
+ * attempts) never fired, and the endpoint stayed dead for minutes; it healed
+ * at once when traffic paused and the counter could climb.
+ */
+
+package device
+
+import (
+	"testing"
+	"time"
+)
+
+// TestDemandDoesNotResetPendingAttempts: a packet staged while the handshake
+// is pending keeps the attempt count, so the next retry expiry is the 3rd and
+// triggers the early rebind that brings the tunnel up.
+func TestDemandDoesNotResetPendingAttempts(t *testing.T) {
+	pair := newGiveUpPair(t, true)
+
+	pkt := buildIPv4Packet(testIPA, testIPB, 8)
+	send := func() { pair.tunA.toDevice <- pkt }
+
+	send() // first (blackholed) initiation
+
+	pair.devA.peers.RLock()
+	peer := pair.devA.peers.keyMap[pair.pkB]
+	pair.devA.peers.RUnlock()
+	if peer == nil {
+		t.Fatal("peer not found")
+	}
+
+	// Two retries already counted, the last initiation just sent.
+	peer.handshake.mutex.Lock()
+	peer.handshake.lastSentHandshake = time.Now()
+	peer.handshake.mutex.Unlock()
+	peer.timers.handshakeAttempts.Store(2)
+
+	// New demand while the handshake is pending: rate-limited, nothing is sent,
+	// and the counter must stay where it is.
+	if err := peer.SendHandshakeInitiation(false); err != nil {
+		t.Fatal(err)
+	}
+	if got := peer.timers.handshakeAttempts.Load(); got != 2 {
+		t.Fatalf("handshakeAttempts = %d after rate-limited demand, want 2", got)
+	}
+
+	// The next retry expiry is the 3rd: the early self-heal rebinds and the
+	// tunnel comes up.
+	peer.handshake.mutex.Lock()
+	peer.handshake.lastSentHandshake = time.Now().Add(-2 * RekeyTimeout)
+	peer.handshake.mutex.Unlock()
+	expiredRetransmitHandshake(peer)
+
+	awaitPacket(t, pair.tunB, pkt, send)
+}
+
+// TestDemandLeavesPendingCycleToRetryTimer: once RekeyTimeout has passed but
+// the retry timer (jittered) has not fired yet, demand must not send a fresh
+// initiation that resets the counter and pushes the timer forward — under
+// steady traffic that kept the retry timer from ever expiring.
+func TestDemandLeavesPendingCycleToRetryTimer(t *testing.T) {
+	pair := newGiveUpPair(t, true)
+
+	pkt := buildIPv4Packet(testIPA, testIPB, 8)
+	send := func() { pair.tunA.toDevice <- pkt }
+
+	send() // first (blackholed) initiation; arms the retry timer
+
+	pair.devA.peers.RLock()
+	peer := pair.devA.peers.keyMap[pair.pkB]
+	pair.devA.peers.RUnlock()
+	if peer == nil {
+		t.Fatal("peer not found")
+	}
+	for deadline := time.Now().Add(2 * time.Second); !peer.timers.retransmitHandshake.IsPending(); {
+		if time.Now().After(deadline) {
+			t.Fatal("retry timer not armed after the first initiation")
+		}
+		time.Sleep(5 * time.Millisecond)
+	}
+
+	// Two retries counted, RekeyTimeout already passed, retry timer still armed.
+	sent := time.Now().Add(-2 * RekeyTimeout)
+	peer.handshake.mutex.Lock()
+	peer.handshake.lastSentHandshake = sent
+	peer.handshake.mutex.Unlock()
+	peer.timers.handshakeAttempts.Store(2)
+
+	if err := peer.SendHandshakeInitiation(false); err != nil {
+		t.Fatal(err)
+	}
+	peer.handshake.mutex.RLock()
+	last := peer.handshake.lastSentHandshake
+	peer.handshake.mutex.RUnlock()
+	if !last.Equal(sent) {
+		t.Fatal("demand sent a fresh initiation during a pending cycle")
+	}
+	if got := peer.timers.handshakeAttempts.Load(); got != 2 {
+		t.Fatalf("handshakeAttempts = %d after demand during a pending cycle, want 2", got)
+	}
+
+	// The retry timer's 3rd expiry triggers the early rebind.
+	expiredRetransmitHandshake(peer)
+	awaitPacket(t, pair.tunB, pkt, send)
+}
