+++ b/option/v2ray_raw.go
@@ -0,0 +1,23 @@
+package option
+
+import "github.com/sagernet/sing/common/json/badoption"
+
+// lx:begin raw
+
+// V2RayRawOptions — транспорт "raw" (TCP) с необязательной HTTP-обфускацией заголовка, как `headerType: http` в Xray/V2Ray.
+// Реализация клиента — плагин вне ядра (vpnclient/ext/rawhttp), регистрируется через transport/v2ray.RegisterClient;
+// без плагина тип "raw" отвергается рантаймом ("unknown transport type: raw").
+type V2RayRawOptions struct {
+	// HeaderType: "" / "none" — без обфускации; "http" — фальшивый HTTP-запрос в начале потока и пропуск HTTP-ответа сервера.
+	HeaderType string `json:"header_type,omitempty"`
+	// Method — метод фальшивого запроса (по умолчанию GET).
+	Method string `json:"method,omitempty"`
+	// Host — значения заголовка Host (выбирается случайное на соединение); пусто — SNI/адрес сервера.
+	Host badoption.Listable[string] `json:"host,omitempty"`
+	// Path — пути запроса (выбирается случайный на соединение); пусто — "/".
+	Path badoption.Listable[string] `json:"path,omitempty"`
+	// Headers — дополнительные заголовки запроса.
+	Headers badoption.HTTPHeader `json:"headers,omitempty"`
+}
+
+// lx:end raw
