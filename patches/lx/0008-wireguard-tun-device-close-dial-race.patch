+//
+// The field is cleared under deviceAccess and the device is closed outside it:
+// Close and Teardown run while dials through the endpoint are still in flight
+// (the protocol layer's Close drops resumeMu before it reaches the transport),
+// and those dials read the field without any of the protocol layer's locks.
 func (e *Endpoint) closeTunDevice() error {
-	if e.tunDevice == nil {
+	e.deviceAccess.Lock()
+	tunDevice := e.tunDevice
+	e.tunDevice = nil
