diff --git a/transport/wireguard/endpoint_tundevice_race_lx_test.go b/transport/wireguard/endpoint_tundevice_race_lx_test.go
new file mode 100644
--- /dev/null
+++ b/transport/wireguard/endpoint_tundevice_race_lx_test.go
@@ -0,0 +1,57 @@
+package wireguard
+
+// lx: SPEC 020 level 3 — Close and Teardown release the tun device while a dial
+// through the endpoint may still be reading the field. The protocol layer's
+// Close drops resumeMu and bindAccess before it reaches the transport Close,
+// and a dial that has passed resumeOnDial holds no lock at all, so nothing
+// orders the two. A nil check followed by a second read of e.tunDevice can see
+// nil on the second read and panic in the dialing goroutine. Run with -race:
+// the detector reports the unsynchronized read and write even when the
+// scheduler does not hit the window.
+
+import (
+	"context"
+	"sync"
+	"testing"
+
+	M "github.com/sagernet/sing/common/metadata"
+)
+
+func TestTunDeviceCloseRacesDial(t *testing.T) {
+	defer SetNewDeviceFnForTest(func(options DeviceOptions) (Device, error) {
+		return newFakeDevice(), nil
+	})()
+	destination := M.ParseSocksaddr("192.0.2.9:80")
+	for i := 0; i < 20; i++ {
+		e := newLazyTransportEndpoint(t, false, "10.0.0.2/32")
+		if err := e.Rebuild(); err != nil { // tun device built, wireguard device never started
+			t.Fatal(err)
+		}
+		start := make(chan struct{})
+		var wg sync.WaitGroup
+		wg.Add(3)
+		go func() {
+			defer wg.Done()
+			<-start
+			_, _ = e.DialContext(context.Background(), "tcp", destination)
+		}()
+		go func() {
+			defer wg.Done()
+			<-start
+			_, _ = e.ListenPacket(context.Background(), destination)
+		}()
+		go func() {
+			defer wg.Done()
+			<-start
+			_ = e.Close() // no wireguard device: Close releases the tun device
+		}()
+		close(start)
+		wg.Wait()
+		if !e.TornDown() {
+			t.Fatal("Close must release the tun device")
+		}
+		if _, err := e.DialContext(context.Background(), "tcp", destination); err == nil {
+			t.Fatal("a dial after Close must fail, not reach a released device")
+		}
+	}
+}
