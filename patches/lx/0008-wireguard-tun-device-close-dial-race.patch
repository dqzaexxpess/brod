+
+// loadTunDevice returns the current tun device, nil once it is released.
+func (e *Endpoint) loadTunDevice() Device {
+	e.deviceAccess.RLock()
+	defer e.deviceAccess.RUnlock()
+	return e.tunDevice
+}
+
+// dialTunDevice and listenTunDevice are the tails of DialContext and
+// ListenPacket: they read the field once, so a Close or Teardown that clears it
+// between a nil check and the call can no longer turn the call into a nil
+// dereference in the dialing goroutine. A torn-down endpoint has no tun device;
+// the protocol layer rebuilds before dialing, so reaching the error means a
+// caller bypassed it or the endpoint is closing.
+func (e *Endpoint) dialTunDevice(ctx context.Context, network string, destination M.Socksaddr) (net.Conn, error) {
+	tunDevice := e.loadTunDevice()
+	if tunDevice == nil {
+		return nil, E.New("WireGuard endpoint is torn down")
+	}
+	return tunDevice.DialContext(ctx, network, destination)
+}
+
+func (e *Endpoint) listenTunDevice(ctx context.Context, destination M.Socksaddr) (net.PacketConn, error) {
+	tunDevice := e.loadTunDevice()
+	if tunDevice == nil {
+		return nil, E.New("WireGuard endpoint is torn down")
+	}
+	return tunDevice.ListenPacket(ctx, destination)
 }
