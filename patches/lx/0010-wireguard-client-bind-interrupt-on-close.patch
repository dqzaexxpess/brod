diff --git a/submodules/wireguard-go/device/lx_bind_interrupt.go b/submodules/wireguard-go/device/lx_bind_interrupt.go
new file mode 100644
--- /dev/null
+++ b/submodules/wireguard-go/device/lx_bind_interrupt.go
@@ -0,0 +1,32 @@
+/* SPDX-License-Identifier: MIT
+ *
+ * lx: sing-box-lx SPEC 071 — let a bind whose Send blocks give up before the
+ * device takes its net lock for writing.
+ */
+
+package device
+
+// bindInterrupter is implemented by a conn.Bind whose Send can block for long:
+// sing-box's ClientBind dials its detour connection inside Send (bounded only
+// by a 15 s dial timeout) and backs off for a second after a failed dial. Send
+// runs under device.net's read lock, and BindClose and BindUpdate close the
+// bind under the write lock, so Down, Close and every rebind waited for the
+// blocked Send to finish on its own: the bind's Close, which cancels the dial,
+// only runs once the write lock is held.
+//
+// InterruptPending must make pending and later Sends of the current bind
+// generation return promptly until the bind is opened again. It may run
+// concurrently with Send, Open and Close.
+type bindInterrupter interface {
+	InterruptPending()
+}
+
+// interruptBind runs right before BindClose and BindUpdate take device.net for
+// writing; both close the bind right after, so nothing is lost by giving up
+// early. device.net.bind is set once in NewDevice and never replaced, so it is
+// read without the lock.
+func (device *Device) interruptBind() {
+	if bind, ok := device.net.bind.(bindInterrupter); ok {
+		bind.InterruptPending()
+	}
+}
