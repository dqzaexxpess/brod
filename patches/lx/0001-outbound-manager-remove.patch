+// lx:begin remove
+
+// Remove удаляет outbound, ранее добавленный Create (или описанный в конфиге), и закрывает его.
+// Нельзя удалить: outbound по умолчанию; outbound, от которого зависят другие (detour, члены групп).
+func (m *Manager) Remove(tag string) error {
+	m.access.Lock()
+	outbound, found := m.outboundByTag[tag]
+	if !found {
+		m.access.Unlock()
+		return os.ErrNotExist
+	}
+	if outbound == m.defaultOutbound {
+		m.access.Unlock()
+		return E.New("cannot remove default outbound: ", tag)
+	}
+	for _, other := range m.outbounds {
+		if other == outbound {
+			continue
+		}
+		for _, dependency := range other.Dependencies() {
+			if dependency == tag {
+				m.access.Unlock()
+				return E.New("cannot remove outbound ", tag, ": used by ", other.Tag())
+			}
+		}
+	}
+	// новый срез, а не правка на месте: Outbounds() отдаёт m.outbounds вызывающим, которые могут итерировать его параллельно
+	remaining := make([]adapter.Outbound, 0, len(m.outbounds))
+	for _, o := range m.outbounds {
+		if o != outbound {
+			remaining = append(remaining, o)
+		}
+	}
+	m.outbounds = remaining
+	delete(m.outboundByTag, tag)
+	delete(m.optionsByTag, tag)
+	m.access.Unlock()
+	return common.Close(outbound)
+}
+
+// lx:end remove
