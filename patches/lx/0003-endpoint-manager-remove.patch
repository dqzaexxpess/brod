+
+// StartDynamic проводит endpoint, добавленный после старта движка, через все стадии запуска в его собственном scope.
+func (m *Manager) StartDynamic(endpoint adapter.Endpoint) error {
+	name := "endpoint/" + endpoint.Type() + "[" + endpoint.Tag() + "]"
+	m.access.Lock()
+	if m.scope == nil {
+		m.access.Unlock()
+		return E.New("endpoint manager is not started")
+	}
+	endpointScope := m.endpointScope(endpoint)
+	m.access.Unlock()
+	for _, stage := range adapter.ListStartStages {
+		if err := endpointScope.Start(name, endpoint, stage); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+// Remove останавливает endpoint (закрывает его scope) и убирает из менеджера.
+func (m *Manager) Remove(tag string) error {
+	m.access.Lock()
+	endpoint, found := m.endpointByTag[tag]
+	if !found {
+		m.access.Unlock()
+		return os.ErrNotExist
+	}
+	remaining := make([]adapter.Endpoint, 0, len(m.endpoints))
+	for _, e := range m.endpoints {
+		if e != endpoint {
+			remaining = append(remaining, e)
+		}
+	}
+	m.endpoints = remaining
+	delete(m.endpointByTag, tag)
+	delete(m.optionsByTag, tag)
+	endpointScope := m.endpointScopes[endpoint]
+	delete(m.endpointScopes, endpoint)
+	closers := make([]endpointCloser, 0, len(m.endpointClosers))
+	for _, c := range m.endpointClosers {
+		if c.scope != endpointScope {
+			closers = append(closers, c)
+		}
+	}
+	m.endpointClosers = closers
+	m.access.Unlock()
+	if endpointScope == nil {
+		return nil
+	}
+	return endpointScope.Close()
+}
+
+// lx:end remove
